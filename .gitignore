# Build output ships via the installer's own build step, never via git.
dist/
node_modules/

# Live state: signing key, issued licenses, revocations, check-ins. NEVER commit.
data/

# Beta tarballs are copied in by the release step; only the contract doc is tracked.
releases/*
!releases/README.md

# scripts/backup-data.sh's default output directory when HUB_BACKUP_DIR is
# unset — private key material in every tarball. NEVER commit.
backups/
