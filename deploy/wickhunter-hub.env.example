# deploy/wickhunter-hub.env.example
#
# Copy to /etc/wickhunter-hub/env, fill in the values install-hub.sh would
# normally generate/prompt for, then:
#   chown wickhunter-hub:wickhunter-hub /etc/wickhunter-hub/env   # or root:root — the unit reads it before dropping privileges
#   chmod 600 /etc/wickhunter-hub/env
#
# install-hub.sh already does all of this for you on an ordinary install —
# this file exists for a from-scratch hardened deploy, or as a reference for
# what each variable means. See README "Running the hub hardened" and
# "Key custody checklist".

# ── required ─────────────────────────────────────────────────────────────
# Random 32+ byte token, compared constant-time. Empty/unset = the ENTIRE
# admin surface answers 503. Generate: `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`
HUB_ADMIN_TOKEN=

# What testers/buyers paste — must be HTTPS with no credentials/query/fragment
# once NODE_ENV=production.
HUB_PUBLIC_ORIGIN=https://hub.example.com

# The dedicated RELEASE key's PUBLIC keyring only — NEVER the private key.
# Generate the key pair OFFLINE (app repo's scripts/generate-release-key.mjs)
# and paste only the public half here, quoted so systemd preserves the JSON.
HUB_RELEASE_PUBLIC_KEYS_JSON='{"release-2026-01":"<base64url public key>"}'

# ── recommended: rate limiting (src/ratelimit.ts) ───────────────────────────
# Every value below has a shipped default (see README "Rate limiting"); set
# only the ones you want to change. All are positive integers.
# HUB_RATE_CHECKIN_LICENSE_MAX=12
# HUB_RATE_CHECKIN_LICENSE_WINDOW_MS=60000
# HUB_RATE_CHECKIN_IP_MAX=60
# HUB_RATE_CHECKIN_IP_WINDOW_MS=60000
# HUB_RATE_LEASE_LICENSE_MAX=6
# HUB_RATE_LEASE_LICENSE_WINDOW_MS=60000
# HUB_RATE_LEASE_IP_MAX=60
# HUB_RATE_LEASE_IP_WINDOW_MS=60000
# HUB_RATE_IP_MAX=60
# HUB_RATE_IP_WINDOW_MS=60000
# HUB_RATE_WEBHOOK_IP_MAX=600
# HUB_RATE_WEBHOOK_IP_WINDOW_MS=60000

# ── recommended: admin-auth hardening ───────────────────────────────────────
# HUB_RATE_ADMIN_FAILURE_THRESHOLD=5
# HUB_RATE_ADMIN_BACKOFF_BASE_MS=60000
# HUB_RATE_ADMIN_BACKOFF_MAX_MS=3600000
# Comma-separated IPs/CIDRs (v4 and v6) allowed to attempt the admin token at
# all. Unset/empty = every IP may attempt it (today's behaviour). Setting
# this WITHOUT including your own current IP locks you out of /admin — keep a
# console/VPS-provider-panel path to the box before you set it.
# HUB_ADMIN_IP_ALLOWLIST=203.0.113.4,198.51.100.0/24

# ── liquidation percentile feed ─────────────────────────────────────────────
# Recording is ON BY DEFAULT (unlike everything below this line) — every
# source is WS-only with no history endpoint anywhere, so a print not
# recorded the instant it prints is gone for good, and recording costs disk
# rather than a paid credit. See README "Liquidation percentile feed".
# HUB_LIQ_RECORD=0                  # the one full off switch
# HUB_LIQ_SOURCES=bybit-usdt,bybit-usdc,bybit-inverse,binance-usdt,binance-inverse,okx-usdt,okx-usdc,okx-inverse

# ── optional: everything else this Hub can do ───────────────────────────────
# See README for the full list (machine-bound leases, seats, candle seed,
# market-cap producer, Marketplace bridge — every one is off/default until
# configured here).
